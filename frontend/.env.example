# ==============================================================================
# EDUGENIE Frontend Client Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local in the frontend directory.
# NEVER commit .env or secrets to version control.
# Only safe, browser-facing configuration belongs here.
# NEVER place backend secrets (e.g. GEMINI_API_KEY, Service Account keys) here.

# Backend API URL
# Development: Leave empty to use relative /api paths via local Vite dev proxy, or set http://localhost:8000
# Production: Set to your live FastAPI backend domain (e.g., https://api.edugenie.example.com)
VITE_API_BASE_URL=https://your-backend-domain.example

# Firebase Client Configuration (Firebase Modular Web SDK)
# Obtain these public client values from:
# Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration -> Config
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
