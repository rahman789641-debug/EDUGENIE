# ==============================================================================
# EDUGENIE Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your local credentials.
# NEVER commit .env or secrets to version control.

# Application Configuration
APP_NAME=EDUGENIE
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (CORS)
# JSON list of allowed origins. In development, includes local Vite dev server.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Google Gemini AI Configuration
# Secrets must live strictly behind the backend API.
# GEMINI_API_KEY: Your Google Gemini API Key from Google AI Studio.
GEMINI_API_KEY=
# GEMINI_MODEL: Active Gemini model identifier (e.g., gemini-2.5-flash, gemini-2.5-pro).
# Configurable via environment to avoid hardcoded deprecations.
GEMINI_MODEL=gemini-3.1-flash-lite

# Firebase Client Configuration (Firebase Modular Web SDK for EduGenie Auth)
# Obtain from Firebase Console -> Project Settings -> General -> Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Backend Admin Configuration (Server-Side ID Token Verification)
# Keep strictly on backend. NEVER expose to React or commit service-account private keys to Git.
# Defaults to project ID with Google Public Key verification if service account file is not provided.
FIREBASE_PROJECT_ID=edugenie-eb3f5
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
FIREBASE_SERVICE_ACCOUNT_KEY=

# External Web Research Configuration (Backend-only, never exposed to clients)
# TAVILY_API_KEY: Optional external search API provider key (e.g., tvly-...)
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=8.0
MAX_SEARCH_RESULTS=5

