# ==============================================================================
# EDUGENIE Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the backend directory.
# NEVER commit .env or secrets to version control.

# Application Configuration
APP_NAME=EDUGENIE
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (CORS)
# Comma-separated or JSON list of trusted frontend origins. Never use "*" in production when credentials are included.
CORS_ORIGINS=["https://your-frontend-domain.example"]
# Or alias:
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example

# Google Gemini AI Configuration (Backend-Only Secret)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Firebase Admin Configuration (Backend-Only Token Verification)
# Used to verify Firebase ID tokens against Google certificates.
FIREBASE_PROJECT_ID=your_firebase_project_id
# Optional: path to service account credentials JSON, or raw JSON string
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
FIREBASE_SERVICE_ACCOUNT_KEY=

# External Web Research Configuration (Backend-Only)
# Optional dedicated web search provider API key (e.g. Tavily)
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=8.0
MAX_SEARCH_RESULTS=5

# Data Persistence & Learning History
DATABASE_PATH=data/edugenie.db
